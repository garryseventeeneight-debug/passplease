generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum QuestionType {
  MCQ
  SHORT_ANSWER
  EXTENDED_RESPONSE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Subject {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  topics    Topic[]
  questions Question[]
  masteries Mastery[]
  createdAt DateTime  @default(now())
}

model Topic {
  id                String       @id @default(cuid())
  subjectId         String
  subject           Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name              String
  syllabusReference String?
  order             Int          @default(0)
  subtopics         Subtopic[]
  questions         Question[]
  masteries         Mastery[]
  learnChunks       LearnChunk[]

  @@unique([subjectId, name])
}

model Subtopic {
  id          String       @id @default(cuid())
  topicId     String
  topic       Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name        String
  order       Int          @default(0)
  questions   Question[]
  masteries   Mastery[]
  learnChunks LearnChunk[]

  @@unique([topicId, name])
}

model Question {
  id               String         @id @default(cuid())
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId          String
  topic            Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicId       String?
  subtopic         Subtopic?      @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  type             QuestionType   @default(MCQ)
  difficulty       Int            @default(1)
  questionText     String
  explanation      String?
  source           String
  sourceUrl        String?
  sourceYear       Int?
  sourcePaper      String?
  syllabusOutcome  String?
  isAiGenerated    Boolean        @default(false)
  isTestFixture    Boolean        @default(false)
  // A small single-concept warm-up MCQ served ahead of the real question for
  // a topic the learner is weak in or new to, so one past-paper question
  // doesn't force several concepts to be juggled at once. scaffoldOrder
  // sequences the ladder within a topic (lower first); ignored otherwise.
  isScaffold       Boolean        @default(false)
  scaffoldOrder    Int            @default(0)
  // false when the correct-option flags came from AI reasoning rather than
  // an official answer key in the source document (question text is still
  // real past-paper content either way — see lib/prisma-adapter.ts sibling
  // note in import-questions.ts for the distinction from isAiGenerated).
  answerVerified   Boolean        @default(true)
  // A rendered PDF page (data:image/jpeg;base64,...) for questions that
  // depend on a real diagram/graph/table — a text description loses
  // information a student needs (e.g. reading a value off a graph), so
  // these are stored as the genuine source image instead of prose.
  imageData        String?
  // User-driven QA: a spot check on any question (especially AI-solved
  // ones) can mark it wrong with a short note, surfaced in the question
  // browser so it's easy to find what needs a second look or a fix.
  flaggedWrong     Boolean        @default(false)
  flagNote         String?
  options          AnswerOption[]
  attempts         Attempt[]
  reviewCards      ReviewCard[]
  // Set when this question IS a Learn concept's comprehension check —
  // back-reference only, LearnChunk.checkQuestionId owns the relation.
  learnChunk       LearnChunk?
  createdAt        DateTime       @default(now())
}

model AnswerOption {
  id         String     @id @default(cuid())
  questionId String
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean    @default(false)
  order      Int        @default(0)
  attempts   Attempt[]
}

model Attempt {
  id               String        @id @default(cuid())
  userId           String
  questionId       String
  question         Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   AnswerOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  correct          Boolean
  // Explicitly said "I don't know" instead of guessing — distinct from a
  // wrong guess so mastery/FSRS can tell an honest gap from a mistake.
  dontKnow         Boolean       @default(false)
  responseTimeMs   Int?
  timestamp        DateTime      @default(now())

  @@index([userId, questionId])
}

// One FSRS card per (user, question) — drives spaced-repetition scheduling.
// Field names/semantics follow the FSRS algorithm (ts-fsrs) directly so the
// stored state maps 1:1 onto its Card type.
model ReviewCard {
  id            String    @id @default(cuid())
  userId        String
  questionId    String
  question      Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Float     @default(0)
  scheduledDays Float     @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         Int       @default(0)
  learningSteps Int       @default(0)
  lastReview    DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([userId, questionId])
  @@index([userId, due])
}

model Mastery {
  id                     String    @id @default(cuid())
  userId                 String
  subjectId              String
  subject                Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId                String
  topic                  Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicId             String?
  subtopic               Subtopic? @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  mcqScore               Float     @default(0)
  shortAnswerScore       Float     @default(0)
  extendedResponseScore  Float     @default(0)
  masteryScore           Float     @default(0)
  updatedAt              DateTime  @updatedAt

  @@unique([userId, topicId])
}

// A short, plain-language reading passage on one small idea within a topic
// — the "interactive textbook" side of the app. Read the passage, then
// answer one comprehension check — which is a real Question in the same
// pool practice draws from, so answering it here counts toward that
// topic's mastery/FSRS exactly like a practice attempt does, and it can
// resurface later during normal practice or a spaced-repetition review.
model LearnChunk {
  id             String        @id @default(cuid())
  topicId        String
  topic          Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicId     String?
  subtopic       Subtopic?     @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  order          Int           @default(0)
  // Globally unique, subject-prefixed (chem-, phys-, econ-, legal-,
  // mathadv-, mathext1-) so a [[wikilink]] can resolve unambiguously
  // across subjects without carrying a subject slug of its own.
  slug           String        @unique
  heading        String
  body           String
  // Null when a concept is only ever reached via a link from elsewhere
  // (a short glossary-style aside) and isn't worth quizzing on its own.
  checkQuestionId String?      @unique
  checkQuestion  Question?     @relation(fields: [checkQuestionId], references: [id], onDelete: SetNull)
  progress       LearnProgress[]
  createdAt      DateTime      @default(now())

  @@unique([topicId, order])
}

// Tracks which chunks a user has read through, so a "Learn" session can
// resume where it left off and pick up on any device.
model LearnProgress {
  id          String     @id @default(cuid())
  userId      String
  chunkId     String
  chunk       LearnChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  completedAt DateTime   @default(now())

  @@unique([userId, chunkId])
}
